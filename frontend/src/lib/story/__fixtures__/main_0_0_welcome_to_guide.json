        { "kind": "blocker", "args": { "a": "0", "block": "true", "fadetime": "0.2" }, "line": 284 },
        { "kind": "name", "args": { "name": "???" }, "text": "Thank you for all of your guidance...", "line": 285 },
        { "kind": "blocker", "args": { "a": "1", "afrom": "0", "b": "255", "bfrom": "0", "block": "true", "fadetime": "0.1", "g": "255", "gfrom": "0", "r": "255", "rfrom": "0" }, "line": 286 },

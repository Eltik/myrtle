        { "kind": "camerashake", "args": { "block": "true", "duration": "0.6", "randomness": "90", "vibrato": "30", "xstrength": "5", "ystrength": "8" }, "line": 239 },
        { "kind": "character", "args": { "name": "char_016_medic" }, "line": 240 },
        { "kind": "name", "args": { "name": "Medic" }, "text": "Aaaahh!", "line": 241 },
        { "kind": "character", "args": { "name": "char_002_amiya_1#7" }, "line": 242 },
        { "kind": "name", "args": { "name": "Amiya" }, "text": "Be careful, everyone! Take cover, and protect Doctor!", "line": 243 },
        { "kind": "name", "args": { "name": "Amiya" }, "text": "These outfits... are they from the Reunion Movement? But how is that possible...", "line": 244 },
        { "kind": "name", "args": { "name": "Amiya" }, "text": "Guards, prepare for battle!", "line": 245 },
        { "kind": "character", "args": { "name": "char_013_riop" }, "line": 246 },
        { "kind": "name", "args": { "name": "Guard" }, "text": "Roger!", "line": 247 },
        { "kind": "character", "args": {}, "line": 248 },
        { "kind": "camerashake", "args": { "block": "false", "duration": "0.5", "randomness": "90", "vibrato": "30", "xstrength": "8", "ystrength": "10" }, "line": 249 },
        { "kind": "blocker", "args": { "a": "1", "afrom": "0", "b": "255", "bfrom": "0", "block": "true", "fadetime": "0.1", "g": "255", "gfrom": "0", "r": "255", "rfrom": "0" }, "line": 250 },
        { "kind": "playsound", "args": { "key": "$d_sp_ballista" }, "line": 251 },
        { "kind": "blocker", "args": { "a": "0", "block": "true", "fadetime": "1.5" }, "line": 252 },
        { "kind": "character", "args": { "name": "char_013_riop" }, "line": 253 },
        { "kind": "name", "args": { "name": "Guard" }, "text": "Curses... Are they after the Doctor?!", "line": 254 },
        { "kind": "character", "args": { "focus": "1", "name": "char_002_amiya_1", "name2": "char_013_riop" }, "line": 255 },
        { "kind": "name", "args": { "name": "Amiya" }, "text": "No... Nobody else should know about the Doctor being here.", "line": 256 },
        { "kind": "character", "args": { "focus": "1", "name": "char_002_amiya_1#7", "name2": "char_013_riop" }, "line": 257 },
        { "kind": "name", "args": { "name": "Amiya" }, "text": "Are you able to reach Kal'tsit?", "line": 258 },
        { "kind": "character", "args": { "focus": "2", "name": "char_002_amiya_1", "name2": "char_013_riop" }, "line": 259 },
        { "kind": "name", "args": { "name": "Guard" }, "text": "I'm not sure why, but the equipment isn't working!", "line": 260 },
        { "kind": "character", "args": { "name": "char_002_amiya_1" }, "line": 261 },
        { "kind": "name", "args": { "name": "Amiya" }, "text": "...Someone has cut off our communications.", "line": 262 },
        { "kind": "name", "args": { "name": "Amiya" }, "text": "Have we been discovered by the Ursus government?", "line": 263 },
        { "kind": "character", "args": { "focus": "2", "name": "char_002_amiya_1", "name2": "char_013_riop" }, "line": 264 },
        { "kind": "name", "args": { "name": "Guard" }, "text": "What do we do now?", "line": 265 },
        { "kind": "character", "args": { "name": "char_002_amiya_1" }, "line": 266 },
        { "kind": "name", "args": { "name": "Amiya" }, "text": "Kal'tsit won't be able to command the battle as we had originally planned.", "line": 267 },
        { "kind": "name", "args": { "name": "Amiya" }, "text": "...", "line": 268 },
        { "kind": "character", "args": { "name": "char_002_amiya_1#7" }, "line": 269 },
        { "kind": "name", "args": { "name": "Amiya" }, "text": "...Dr. {@nickname}.", "line": 270 },
        { "kind": "name", "args": { "name": "Amiya" }, "text": "I hope that... you'll be able to take command.", "line": 271 },
        { "kind": "character", "args": { "focus": "1", "name": "char_016_medic", "name2": "char_002_amiya_1" }, "line": 272 },
        { "kind": "name", "args": { "name": "Medic" }, "text": "Isn't that a bit too risky? The Doctor only just came to...", "line": 273 },
        { "kind": "character", "args": { "focus": "2", "name": "char_016_medic", "name2": "char_002_amiya_1" }, "line": 274 },
        { "kind": "name", "args": { "name": "Amiya" }, "text": "I'd like... to give it a try.", "line": 275 },
        { "kind": "character", "args": { "name": "char_002_amiya_1" }, "line": 276 },
        { "kind": "name", "args": { "name": "Amiya" }, "text": "Even without memories, Doctor has...", "line": 277 },
        { "kind": "name", "args": { "name": "Amiya" }, "text": "...fought alongside us before.", "line": 278 },
        { "kind": "blocker", "args": { "a": "1", "afrom": "0", "b": "255", "bfrom": "0", "block": "true", "fadetime": "0.1", "g": "255", "gfrom": "0", "r": "255", "rfrom": "0" }, "line": 279 },

        { "kind": "camerashake", "args": { "block": "false", "duration": "0.5", "randomness": "90", "vibrato": "30", "xstrength": "8", "ystrength": "10" }, "line": 213 },
        { "kind": "character", "args": { "name": "char_1002_nsabr_1" }, "line": 214 },
        { "kind": "blocker", "args": { "a": "1", "afrom": "0", "b": "255", "bfrom": "0", "block": "true", "fadetime": "0.1", "g": "255", "gfrom": "0", "r": "255", "rfrom": "0" }, "line": 215 },

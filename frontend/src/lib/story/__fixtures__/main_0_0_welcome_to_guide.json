        { "kind": "character", "args": { "focus": "1", "name": "char_016_medic", "name2": "char_002_amiya_1#4" }, "line": 105 },
        { "kind": "name", "args": { "name": "Medic" }, "text": "...I understand. Anyway, I'll do what you requested.", "line": 106 },

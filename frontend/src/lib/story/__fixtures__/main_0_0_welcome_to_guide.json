        { "kind": "name", "args": { "name": "Amiya" }, "text": "You...", "line": 158 },
        { "kind": "name", "args": { "name": "Amiya" }, "text": "You're a member of Rhodes Island, just like us...", "line": 159 },
        { "kind": "name", "args": { "name": "Amiya" }, "text": "...as well as my partner.", "line": 160 },
        { "kind": "name", "args": { "name": "Amiya" }, "text": "...Dr. {@nickname}.", "line": 161 },
        { "kind": "name", "args": { "name": "Amiya" }, "text": "You're the most important person to me.", "line": 162 },
        { "kind": "name", "args": { "name": "Amiya" }, "text": "Doctor... you don't remember?", "line": 163 },

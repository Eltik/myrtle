        { "kind": "character", "args": { "name": "char_013_riop" }, "line": 233 },
        { "kind": "name", "args": { "name": "Heavily-Armed Man" }, "text": "They're attacking! Amiya, they're heavily equipped with weapons!", "line": 234 },
        { "kind": "blocker", "args": { "a": "0.7", "b": "0.95", "block": "true", "fadetime": "0.02", "g": "0.95", "r": "0.95" }, "line": 235 },

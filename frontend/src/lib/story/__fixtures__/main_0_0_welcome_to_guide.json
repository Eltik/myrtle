        { "kind": "character", "args": { "name": "char_013_riop" }, "line": 226 },
        { "kind": "name", "args": { "name": "Heavily-Armed Man" }, "text": "What's the meaning of this?!", "line": 227 },
        { "kind": "dialog", "args": {}, "line": 228 },
        { "kind": "blocker", "args": { "a": "0.7", "b": "0.95", "block": "true", "fadetime": "0.02", "g": "0.95", "r": "0.95" }, "line": 229 },

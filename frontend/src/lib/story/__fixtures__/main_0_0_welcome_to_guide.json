        { "kind": "name", "args": { "name": "Heavily-Armed Man" }, "text": "Someone broke into the facility!", "line": 208 },
        { "kind": "blocker", "args": { "a": "1", "afrom": "0", "b": "0", "bfrom": "0", "block": "true", "fadetime": "0.6", "g": "0", "gfrom": "0", "r": "0", "rfrom": "0" }, "line": 209 },

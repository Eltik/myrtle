        { "kind": "character", "args": { "focus": "2", "name": "char_002_amiya_1#6", "name2": "char_013_riop" }, "line": 219 },
        { "kind": "name", "args": { "name": "Heavily-Armed Man" }, "text": "The way they're dressed... they don't look like Ursus soldiers!", "line": 220 },
        { "kind": "character", "args": { "name": "char_1002_nsabr_1" }, "line": 221 },
        { "kind": "camerashake", "args": { "block": "false", "duration": "1", "randomness": "90", "vibrato": "30", "xstrength": "4", "ystrength": "4" }, "line": 222 },
        { "kind": "playsound", "args": { "key": "$d_gen_soldiersrun" }, "line": 223 },

        { "kind": "character", "args": { "name": "char_002_amiya_1#6" }, "line": 148 },
        { "kind": "name", "args": { "name": "Amiya" }, "text": "Ah, Doctor... It's me...", "line": 149 },
        { "kind": "character", "args": { "name": "char_002_amiya_1#4" }, "line": 150 },
        { "kind": "name", "args": { "name": "Amiya" }, "text": "...", "line": 151 },
        { "kind": "character", "args": { "name": "char_002_amiya_1" }, "line": 152 },
        { "kind": "name", "args": { "name": "Amiya" }, "text": "It's me, Amiya.", "line": 153 },
        { "kind": "name", "args": { "name": "Amiya" }, "text": "We've come to rescue you.", "line": 154 },
        { "kind": "decision", "args": { "options": "...Who... am I...?", "values": "1" }, "line": 155 },

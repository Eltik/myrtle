        { "kind": "blocker", "args": { "a": "0", "block": "true", "fadetime": "0.2" }, "line": 301 },
        { "kind": "name", "args": { "name": "???" }, "text": "I know that you'll lead us to victory.", "line": 302 },
        { "kind": "blocker", "args": { "a": "1", "afrom": "0", "b": "255", "bfrom": "0", "block": "true", "fadetime": "0.1", "g": "255", "gfrom": "0", "r": "255", "rfrom": "0" }, "line": 303 },
        { "kind": "playsound", "args": { "key": "$flashback", "volume": "0.1" }, "line": 304 },

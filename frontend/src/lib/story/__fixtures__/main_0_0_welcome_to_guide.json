        { "kind": "character", "args": { "focus": "2", "name": "char_016_medic", "name2": "char_002_amiya_1#4" }, "line": 114 },
        { "kind": "name", "args": { "name": "Amiya" }, "text": "Thank you... Thank you very much!", "line": 115 },

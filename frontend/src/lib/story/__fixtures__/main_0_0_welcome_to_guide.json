        { "kind": "blocker", "args": { "a": "0", "block": "true", "fadetime": "0.1" }, "line": 291 },
        { "kind": "name", "args": { "name": "Amiya" }, "text": "...", "line": 292 },
        { "kind": "character", "args": { "name": "char_002_amiya_1" }, "line": 293 },
        { "kind": "name", "args": { "name": "Amiya" }, "text": "We've been through so much together...", "line": 294 },
        { "kind": "name", "args": { "name": "Amiya" }, "text": "Doctor... I just know that you'll be able to do it.", "line": 295 },
        { "kind": "blocker", "args": { "a": "1", "afrom": "0", "b": "255", "bfrom": "0", "block": "true", "fadetime": "0.1", "g": "255", "gfrom": "0", "r": "255", "rfrom": "0" }, "line": 296 },

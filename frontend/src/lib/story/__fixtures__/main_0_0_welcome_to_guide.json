        { "kind": "character", "args": { "name": "char_002_amiya_1" }, "line": 307 },
        { "kind": "blocker", "args": { "a": "0", "block": "true", "fadetime": "0.1" }, "line": 308 },
        { "kind": "name", "args": { "name": "Amiya" }, "text": "I understand that asking you to do this is very sudden and inconsiderate.", "line": 309 },
        { "kind": "name", "args": { "name": "Amiya" }, "text": "But... Please, lend us your aid.", "line": 310 },
        { "kind": "character", "args": { "name": "char_002_amiya_1#2" }, "line": 311 },
        { "kind": "name", "args": { "name": "Amiya" }, "text": "We'll be supporting you!", "line": 312 },
        { "kind": "decision", "args": { "options": "Let's push them back first!;...;We have no choice but to fight back, right?", "values": "1;2;3" }, "line": 313 },
        { "kind": "predicate", "args": { "references": "1;2;3" }, "line": 314 },
        { "kind": "character", "args": { "name": "char_002_amiya_1" }, "line": 315 },
        { "kind": "name", "args": { "name": "Amiya" }, "text": "Mm... I don't want to drag you into this.", "line": 316 },
        { "kind": "name", "args": { "name": "Amiya" }, "text": "But right now, we need your wisdom more than ever, Dr. {@nickname}.", "line": 317 },
        { "kind": "name", "args": { "name": "Amiya" }, "text": "I hope that a part of you will reawaken during combat.", "line": 318 },
        { "kind": "character", "args": { "name": "char_002_amiya_1#4" }, "line": 319 },
        { "kind": "name", "args": { "name": "Amiya" }, "text": "Even though you might have doubts about yourself...", "line": 320 },
        { "kind": "character", "args": {}, "line": 321 },
        { "kind": "background", "args": {}, "line": 322 },
        { "kind": "name", "args": { "name": "Amiya" }, "text": "But I believe in you.", "line": 323 },
        { "kind": "image", "args": { "fadetime": "0.8", "image": "avg_0_3" }, "line": 324 },
        { "kind": "name", "args": { "name": "Amiya" }, "text": "I know you can do this.", "line": 325 },
        { "kind": "name", "args": { "name": "Amiya" }, "text": "Please take command... of Rhodes Island!", "line": 326 },
        { "kind": "delay", "args": { "time": "0.6" }, "line": 327 },

        { "kind": "name", "args": { "name": "Amiya" }, "text": "I understand. I know this is a bit much to take in right now.", "line": 168 },
        { "kind": "name", "args": { "name": "Amiya" }, "text": "I don't expect you to remember everything right away, and I'm not asking you to trust me right now.", "line": 169 },

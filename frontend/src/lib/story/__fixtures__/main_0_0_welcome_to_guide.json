        { "kind": "character", "args": { "name": "char_002_amiya_1#4" }, "line": 180 },
        { "kind": "name", "args": { "name": "Amiya" }, "text": "I, I don't know how to put this, but so many things have changed from before.", "line": 181 },
        { "kind": "name", "args": { "name": "Amiya" }, "text": "That includes me as well.", "line": 182 },
        { "kind": "predicate", "args": { "references": "1;2;3" }, "line": 183 },
        { "kind": "character", "args": { "name": "char_002_amiya_1#1" }, "line": 184 },
        { "kind": "name", "args": { "name": "Amiya" }, "text": "However, you'll always be the most important person to me, Doctor. No matter what happens, this will never change.", "line": 185 },
        { "kind": "name", "args": { "name": "Amiya" }, "text": "So that's why, please... give me a little more time.", "line": 186 },
        { "kind": "name", "args": { "name": "Amiya" }, "text": "However little it might be...", "line": 187 },
        { "kind": "decision", "args": { "options": "......", "values": "1" }, "line": 188 },
        { "kind": "predicate", "args": { "references": "1" }, "line": 189 },
        { "kind": "character", "args": { "focus": "2", "name": "char_002_amiya_1#1", "name2": "char_016_medic" }, "line": 190 },
        { "kind": "name", "args": { "name": "Medic" }, "text": "Does the doctor... really have amnesia?", "line": 191 },
        { "kind": "character", "args": { "focus": "1", "name": "char_002_amiya_1#1", "name2": "char_016_medic" }, "line": 192 },
        { "kind": "name", "args": { "name": "Amiya" }, "text": "...", "line": 193 },
        { "kind": "name", "args": { "name": "Amiya" }, "text": "I'm sure everything will be fine if we give Doctor some space...", "line": 194 },
        { "kind": "decision", "args": { "options": "Where is this...", "values": "1" }, "line": 195 },
        { "kind": "predicate", "args": { "references": "1" }, "line": 196 },

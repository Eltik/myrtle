{
  "name": "frontend",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "packageManager": "bun@1.3.12",
  "scripts": {
    "dev": "vite dev --port 3000",
    "gen:types": "rm -rf src/types/generated && cd ../backend && cargo test export_bindings && cargo test --test bindings_shape_test && cd ../frontend && bunx --bun biome check --write src/types/generated",
    "gen:check": "cd ../backend && cargo test export_bindings >/dev/null && cd .. && git diff --exit-code --stat frontend/src/types/generated || (echo 'Generated bindings are stale. Run: bun run gen:types' >&2 && exit 1)",
    "build": "NODE_OPTIONS=--max-old-space-size=6144 vite build",
    "preview": "vite preview",
    "start": "bun .output/server/index.mjs",
    "test": "vitest run",
    "i18n:extract": "node scripts/i18n-extract.mjs",
    "i18n:check": "node scripts/i18n-extract.mjs --check",
    "i18n:sync": "node scripts/i18n-extract.mjs --sync",
    "format": "biome format",
    "lint": "biome lint",
    "check": "biome check",
    "postinstall": "bun scripts/heal-node-modules.mjs && (test -f node_modules/@base-ui/utils/addEventListener.js || (mkdir -p node_modules/@base-ui/utils && curl -sL https://registry.npmjs.org/@base-ui/utils/-/utils-0.5.0.tgz | tar -xz -C node_modules/@base-ui/utils --strip-components=1))"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/orbitron": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/noto-sans-sc": "^5.3.0",
    "@react-pdf/renderer": "^4.9.0",
    "@resvg/resvg-js": "^2.6.2",
    "@t3-oss/env-core": "^0.13.11",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-query": "latest",
    "@tanstack/react-query-devtools": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-router-ssr-query": "latest",
    "@tanstack/react-start": "latest",
    "@tanstack/react-store": "latest",
    "@tanstack/react-virtual": "^3.14.14",
    "@tanstack/router-plugin": "^1.168.43",
    "@tanstack/store": "latest",
    "@vidstack/react": "1.15.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "gif.js": "^0.2.0",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.55.0",
    "mp4-muxer": "^5.2.2",
    "pdf-lib": "^1.17.1",
    "pixi-spine": "4.0.6",
    "pixi.js": "7.4.3",
    "react": "^19.3.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "satori": "^0.26.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.5",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/devtools-event-client": "latest",
    "@tanstack/devtools-vite": "latest",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^28.1.0",
    "nitro": "^3.0.260415-beta",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^3.2.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}

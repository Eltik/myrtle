BACKEND_URL="http://localhost:3060"
VITE_BACKEND_URL="https://api.myrtle.moe"
VITE_SITE_URL="https://myrtle.moe"
# Optional: where the browser loads raw-tree assets (textures, spine, audio, video,
# portraits) from the object store. Set it to `S3_PUBLIC_URL` + "/" + `S3_PREFIX` from
# backend/.env (just `S3_PUBLIC_URL` when there is no prefix), no trailing slash, e.g.
# "https://assets.myrtle.moe/assets". Unset: every asset comes from the backend as before.
# The bucket needs CORS for this site (`asset-sync cors --allow-origin <VITE_SITE_URL>`),
# because the story and share-image code read pixels from crossOrigin="anonymous" images.
# VITE_ASSET_BASE_URL=""

# Source repository for the /changelog page ("owner/repo" or a full GitHub URL).
GITHUB_REPO="Eltik/myrtle"
# Optional: a GitHub token raises the API rate limit (60 -> 5000 req/hr).
# GITHUB_TOKEN=""
# Optional: pin a branch instead of the repo's default branch.
# GITHUB_BRANCH=""
SERVICE_KEY="some-key"

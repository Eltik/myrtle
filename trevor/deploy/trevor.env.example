# /etc/trevor/trevor.env: read by systemd for trevor-worker, trevor-update and trevor-summaries.
# Install as root:root, mode 600 (deploy/README.md step 7). No quotes needed; one VAR=value per line.
# This file holds values only. The variables the BACKEND reads (TREVOR_WORKER_KEY's other half, the queue caps,
# TREVOR_MODE, TREVOR_CPU_PROFILE, the kill switches) are documented once, in backend/README.md, section "Trevor".

# --- secrets -----------------------------------------------------------------------------------------------------
# The scoped worker key (contract v1 section 3); the backend's TREVOR_WORKER_KEY holds the same value.
TREVOR_WORKER_KEY=
# Cloudflare Workers AI, free plan, no card (decision D1). Unset = the cf rung and Cloudflare summaries are off.
# Leave unset unless the Cloudflare rung is used; this deployment uses cache and cpu only.
#TREVOR_CF_ACCOUNT_ID=
#TREVOR_CF_API_TOKEN=
# Model ids in order of preference; a retired id fails over to the next (worker and summaries alike).
#TREVOR_CF_MODELS=@cf/google/gemma-4-26b-a4b-it
# How thinking is turned off: unset = chat_template_kwargs.enable_thinking false; effort; omit.
#TREVOR_CF_THINKING=
# Optional: the Discord webhook the update script posts to: one update_failed alert per failed run (step, exit code,
# last log lines) and a "published" notice. Same name and value as the backend's own alert webhook (core::alerts,
# contract v1.1 section 2.2), which the backend reads from its environment, not from this file. Only the update script
# falls back to TREVOR_DISCORD_WEBHOOK (the name before 2026-10-17) when this one is empty; the backend never reads it.
DISCORD_ALERT_WEBHOOK=

# --- paths -------------------------------------------------------------------------------------------------------
TREVOR_DIR=/var/www/myrtle.moe/trevor
TREVOR_HOME=/var/lib/trevor
ASSETS_DIR=/var/www/myrtle.moe/assets
TREVOR_BACKEND=http://127.0.0.1:3060
TREVOR_LLM_URL=http://127.0.0.1:8081
TREVOR_LLM_LOCK=/run/trevor/llm.lock
TREVOR_SPOOL_DIR=/var/lib/trevor/spool
# The worker's Cloudflare canary result (ask --canary) lives outside the release directories.
TREVOR_CANARY_FILE=/var/lib/trevor/state/cf-canary.json

# --- serving -----------------------------------------------------------------------------------------------------
# bm25 until fp32 vectors exist (deploy/README.md step 9); then hybrid.
TREVOR_RETRIEVAL=bm25
# Further ask flags for the worker, split on spaces (e.g. --no-stream).
TREVOR_WORKER_ARGS=

# --- the update jobs (scripts/trevor-vps-update.sh) ---------------------------------------------------------------------
# 0 with TREVOR_RETRIEVAL=bm25; 1 once the vectors are fp32 (model.onnx).
EMBED=0
EMBED_ONNX=model.onnx
# Only the serving corpora get new vectors (ask's main corpus and P4x).
EMBED_DIRS=artifacts/p3b artifacts/p4x
# 1 = the 10-question canary through the serving llama-server runs in the gates (about 10 to 30 min on one core).
CANARY=1
# ask flags for the canary: the mid profile, which the cpu rung serves (contract v1.1 section 4; backend
# TREVOR_CPU_PROFILE, default mid) and which fits the serving server's 4,096-token slot (the full profile's 9,000 does
# not), and the worker's retrieval. Unset = exactly this, with TREVOR_RETRIEVAL. When the backend runs with
# TREVOR_CPU_PROFILE=slim, set --profile slim here too, so the canary checks what the rung serves.
#GATES_ASK_FLAGS=--profile mid --retrieval bm25
# Overnight summaries on the local E2B after the Cloudflare window.
LOCAL_SUMMARIES=1
E2B_GGUF=/var/www/myrtle.moe/trevor/models/llm/gemma-4-e2b-it-q4_k_m.gguf
LLAMA_SERVER=/usr/local/bin/llama-server
SUMMARY_THREADS=2
SUMMARY_UNTIL=07:00
# Pre-generated bank answers for chunks an update added or changed (contract v1.1 section 3a; scripts/bank_regen.py),
# made after the summaries on the same Cloudflare window and E2B server. 0 = never regenerated (the bank as before).
REGEN_ANSWERS=1
# At most this many pending units a night (a changed chunk = 1 question + 1 mid answer); the rest wait a night.
REGEN_MAX_UNITS=150
# The warm-up after a publish: the backend's most-asked questions not carried over, re-asked as deferred jobs.
TREVOR_WARM_TOP=100
KEEP_RELEASES=3
# Retention (scripts/retention.py, run by `daily` after a successful publish and by `trevor-vps-update.sh prune`).
# Dry run by default: the log lists what is over the policy and nothing is deleted until PRUNE_APPLY=1. PRUNE=0 skips
# the step. Defaults: logs newest 30, eval runs newest 50 (plus each gold set's newest and any run a doc names), spool
# 14 days, releases the current, the previous and the newest 5. The asset download's old .idx manifests go only with
# PRUNE_APPLY_ASSETS=1 as well.
PRUNE=1
PRUNE_APPLY=0
PRUNE_APPLY_ASSETS=0
RETAIN_LOGS=30
RETAIN_RUNS=50
RETAIN_SPOOL_DAYS=14
RETAIN_RELEASES=5
# The disk check on every `daily` run: a Discord warning (DISCORD_ALERT_WEBHOOK) below the smaller of these two.
# DISK_CHECK=0 turns it off.
DISK_CHECK=1
DISK_MIN_FREE_GB=10
DISK_MIN_FREE_PCT=10
# The stale game-table check on every `daily` run: one Discord embed per table the first time .skipped.json lists
# it (keyed on table and since). STALE_CHECK=0 turns it off.
STALE_CHECK=1
# The nightly re-answer (scripts/reanswer.py, step 6): the database the live asks are read from (psql on PATH); falls
# back to TREVOR_DATABASE_URL, then DATABASE_URL. REANSWER=0 makes its merge a no-op.
#REANSWER_DSN=postgres://user:password@127.0.0.1:5432/myrtle
REANSWER=1

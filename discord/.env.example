DISCORD_TOKEN=""
DISCORD_ID=""
DATABASE_URL="sqlite:database.sqlite"

# Optional: path to the bot config JSON (defaults to ./config.json)
# DISCORD_CONFIG_PATH="config.json"

# Optional: messages the cache keeps per channel (default 200). The audit log reads a
# deleted message's content from this cache, so a message older than the newest N in its
# channel is logged without its content. 1000 was the bound before 2026-10-19.
# DISCORD_MAX_MESSAGES="200"
